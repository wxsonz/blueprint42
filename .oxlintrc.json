{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "off"
  },
  "rules": {
    "eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "no-shadow": "error",
    "typescript/no-floating-promises": "error"
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "samples/**",
    "stress/**"
  ]
}
